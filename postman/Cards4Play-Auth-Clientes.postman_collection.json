              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Incluye al cliente creado y no muestra contraseñas\", function () {",
                  "  const lista = pm.response.json();",
                  "  pm.expect(lista).to.be.an(\"array\");",
                  "  const nombre = pm.collectionVariables.get(\"nuevoUsuario\");",
                  "  pm.expect(lista.map(c => c.usuario)).to.include(nombre);",
                  "  lista.forEach(c => { pm.expect(c).to.not.have.property(\"contrasena\"); pm.expect(c.rol).to.eql(\"CLIENTE\"); });",
                  "});"
                ]
              }
            }
