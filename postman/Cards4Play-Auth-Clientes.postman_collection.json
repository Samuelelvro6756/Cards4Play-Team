  },
  "item": [
    {
      "name": "Auth",
      "description": "Autenticación HTTP Basic: /salud es público; todo lo demás exige usuario y clave.",
      "item": [
        {
          "name": "Salud (público, sin autenticación)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"estado = ok\", function () { pm.expect(pm.response.json().estado).to.eql(\"ok\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud"
              ]
            }
          }
        },
        {
          "name": "Quién soy (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Es el administrador\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.rol).to.eql(\"ADMIN\");",
                  "  pm.expect(j.usuario).to.eql(pm.variables.get(\"adminUsuario\"));",
                  "});",
                  "pm.test(\"No devuelve la contraseña\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.not.have.property(\"contrasena\");",
                  "  pm.expect(j).to.not.have.property(\"clave\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "basic",
