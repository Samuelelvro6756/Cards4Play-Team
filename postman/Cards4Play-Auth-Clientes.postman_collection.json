    {
      "name": "Clientes",
      "description": "Registro y listado de clientes (solo el administrador). El orden importa: la primera petición crea el cliente que usan las siguientes.",
      "item": [
        {
          "name": "Crear cliente (admin) → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"nuevoUsuario\", \"cliente_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Devuelve el cliente creado, sin contraseña\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.rol).to.eql(\"CLIENTE\");",
                  "  pm.expect(j.usuario).to.eql(pm.collectionVariables.get(\"nuevoUsuario\"));",
                  "  pm.expect(j).to.have.property(\"id\");",
                  "  pm.expect(j).to.not.have.property(\"contrasena\");",
                  "  pm.expect(j).to.not.have.property(\"clave\");",
                  "  pm.collectionVariables.set(\"clienteId\", j.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{adminUsuario}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{adminClave}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{nuevoUsuario}}\",\n  \"clave\": \"{{nuevaClave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
